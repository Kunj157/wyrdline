# Wyrdline kernel sensor. Install with `sudo make sensord-install`.
[Unit]
Description=Wyrdline eBPF sensor (kernel effect capture for agent sessions)
Documentation=https://github.com/Kunj157/wyrdline/blob/dev/docs/architecture/sensor.md
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/bin/wyrd-sensord --socket /run/wyrdline/sensord.sock
Restart=on-failure
RestartSec=2

# Only what loading tracepoint programs and reading tracefs/cgroupfs needs.
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_RESOURCE CAP_DAC_READ_SEARCH CAP_SYS_ADMIN
AmbientCapabilities=
NoNewPrivileges=yes
# No network: the daemon only serves a unix socket.
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
PrivateNetwork=yes
# Read-only system, private /tmp, no access to home directories.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
RuntimeDirectory=wyrdline
RuntimeDirectoryMode=0755
ProtectKernelModules=yes
ProtectControlGroups=no
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
